   "max": 0.6,
   "step": 0.01,
   "default": 0.3,
   "more": true
  }
 ],
 "plot": {
  "type": "ladder",
  "scale": "log",
  "domain": [
   0.01,
   100000
  ],
  "units": {
   "Wh/hour": "Wh",
   "W": "Wh"
  },
  "count": {
   "unit": "prompt",
   "noun": "text prompt",
   "nouns": "text prompts",
   "cap": 500
  },
