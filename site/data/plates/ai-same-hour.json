{
 "schema": 1,
 "tier": "T0",
 "page": "ai/index.html",
 "id": "ai-same-hour",
 "fit": true,
 "model": "comparison-model",
 "by": "boundary",
 "default": "chat",
 "eyebrow": "The same hour",
 "title": "On the same phone, ten text prompts add about {now[chat][activity_added]:.0f} Wh in the data center and an hour of video about {now[video][activity_added]:.0f} Wh in the data center and network; the screen and router add {fixed} Wh to either hour (modeled, 11/2026)",
 "subtitle": "Energy for one hour, in watt-hours, one boundary at a time.",
 "text": [
  "Resolution #2026-039 set up this task force to identify what member Tribes hold in common on AI. The first question most readers bring is whether their own chat use is the problem, so the page starts there: one hour of chat, video, and a short-video feed on the same phone, each segment labeled measured or modeled."
 ],
 "inputs": {
  "now": {
   "model": "computed_defaults.same_hour.default"
  },
  "lo": {
   "model": "computed_defaults.same_hour.low"
  },
  "hi": {
   "model": "computed_defaults.same_hour.high"
  },
  "prompt": {
   "model": "inputs.chat_wh_per_prompt.value"
  },
  "house": {
   "model": "inputs.household_wh_per_day.value"
  },
  "tv_wh": {
   "model": "inputs.device_wh_per_hour.tv"
  },
  "m": {
   "model": "inputs"
  },
  "a": {
   "model": "assumptions"
  },
  "want": {
   "model": "computed_defaults"
  },
  "k_r_low": {
   "claim": "fp-019",
   "field": "low"
  },
  "k_r_high": {
   "claim": "fp-019",
   "field": "high"
  },
  "k_h_low": {
   "claim": "fp-025",
   "field": "low"
  },
  "k_h_high": {
   "claim": "fp-025",
   "field": "high"
  },
  "over_lo": {
   "claim": "fp-020",
   "field": "low"
  },
  "over_hi": {
   "claim": "fp-020",
   "field": "high"
  }
 },
