    "id": "fixed",
    "label": "Screen and router",
    "value": "now.chat.router + now.chat.device",
    "unit": "Wh",
    "when": {
     "boundary": "whole"
    }
   }
  ],
  "fold": true
 },
 "fields": {
  "fixed": {
   "formula": "now.chat.router + now.chat.device"
  }
 },
